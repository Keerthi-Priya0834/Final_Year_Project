# API
APP_ENV=development

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=eyeq-scans
MINIO_USE_SSL=false
MINIO_PRESIGN_ENDPOINT=localhost:9000
MINIO_PRESIGN_USE_SSL=false

# Inference
INFERENCE_URL=http://inference:8001
USE_MOCK_MODEL=true

# LLM
GROQ_API_KEY=your-groq-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/eyeq.db
